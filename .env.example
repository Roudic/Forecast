# Firebase web app config (Firebase console > Project settings > Your apps > Web app)
# Leave these blank to run in demo mode with sample data saved only on this device.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Store number. Each store gets its own data under stores/{id} in Firestore.
VITE_STORE_ID=06123
VITE_STORE_NAME=Hueytown
